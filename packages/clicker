local Button = dofile("/lib/gelaxy/button.lua")
local lapi = dofile("/lib/lapi.lua")

local score = 0
local save_path = "/lightOS/clicker.cfg"

if fs.exists(save_path) then
    local config = lapi.loadConfig(save_path)
    if config and config.score then
        score = tonumber(config.score) or 0
    end
end

local function draw_gui()
    term.setBackgroundColor(colors.purple)
    term.setTextColor(colors.white)
    term.clear()
    
    local title = "=== GELAXY CLICKER ==="
    local w, h = term.getSize()
    term.setCursorPos(math.floor((w - #title) / 2) + 1, 3)
    print(title)
    
    local score_text = "Clicks: " .. score
    term.setCursorPos(math.floor((w - #score_text) / 2) + 1, 5)
    print(score_text)
end

local function onClick()
    score = score + 1
    draw_gui()
end

local function onExit()
    local file = fs.open(save_path, "w")
    if file then
        file.writeLine("score=" .. score)
        file.close()
    end
    
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.white)
    term.clear()
    term.setCursorPos(1, 1)
    print("Game Saved: score d: " .. score)
    
    _G.game_running = false
end

draw_gui()

local clickButton = Button.new(14, 8, 16, "   CLICK ME!   ", colors.yellow, colors.black, onClick)
local exitButton = Button.new(17, 12, 10, "  SAVE & EXIT  ", colors.red, colors.white, onExit)

clickButton:draw()
exitButton:draw()

_G.game_running = true
while _G.game_running do
    local evData = { os.pullEvent() }
    local event = evData[1]
    
    if event == "mouse_click" then
        local cx, cy = evData[3], evData[4]
        
        clickButton:handleClick(cx, cy)
        exitButton:handleClick(cx, cy)
        
        clickButton:draw()
        exitButton:draw()
    end
end