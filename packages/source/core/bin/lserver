-- lserver.lua - lightWeb server.

local PROTOCOL = "lweb"
local DEFAULT_IP = "localpage:2525"

local function openModem()
    local sides = peripheral.getNames()
    for _, name in ipairs(sides) do
        if peripheral.getType(name) == "modem" then
            rednet.open(name)
            return true, name
        end
    end
    return false, "No modem found"
end

write("Site files directory: ")
local siteDir = read()

if not fs.exists(siteDir) or not fs.isDir(siteDir) then
    printError("Directory not found: " .. tostring(siteDir))
    return
end

local indexPath = fs.combine(siteDir, "index.lua")
if not fs.exists(indexPath) then
    printError("index.lua not found in: " .. siteDir)
    return
end

write("Site address [" .. DEFAULT_IP .. "]: ")
local customIp = read()
if not customIp or customIp == "" then
    customIp = DEFAULT_IP
end

local ip = "lpage://" .. customIp


local function resolvePagePath(pageName)
    local fileName = (pageName == nil or pageName == "") and "index" or pageName
    return fs.combine(siteDir, fileName .. ".lua")
end

local statePath = fs.combine(siteDir, ".state.lua")
local state = {}

local function loadState()
    if fs.exists(statePath) then
        local f = fs.open(statePath, "r")
        local content = f.readAll()
        f.close()

        local ok, loaded = pcall(textutils.unserialize, content)
        if ok and type(loaded) == "table" then
            state = loaded
        end
    end
end

local function saveState()
    local f = fs.open(statePath, "w")
    f.write(textutils.serialize(state))
    f.close()
end

loadState()

local ok, modemSide = openModem()
if not ok then
    printError("lserver: " .. tostring(modemSide))
    return
end

rednet.host(PROTOCOL, ip)

term.setTextColor(colors.green)
print("lserver running")
term.setTextColor(colors.white)
print("Address: " .. ip)
print("Files:   " .. siteDir)
print("Modem:   " .. modemSide)
print("")
print("Press Ctrl+T to stop the server.")

while true do
    local senderId, request, protocol = rednet.receive(PROTOCOL)

    if type(request) == "table" then
        local response = { ok = false }

        if request.action == "getPage" then
            local pagePath = resolvePagePath(request.page)

            if not fs.exists(pagePath) then
                response.ok = false
                response.error = "Page not found: " .. tostring(request.page or "index")
            else
                local f = fs.open(pagePath, "r")
                local source = f.readAll()
                f.close()

                response.ok = true
                response.source = source
            end

        elseif request.action == "getState" then
            response.ok = true
            response.value = state[request.key]

        elseif request.action == "setState" then
            state[request.key] = request.value
            saveState()
            response.ok = true

        else
            response.ok = false
            response.error = "Unknown action: " .. tostring(request.action)
        end

        rednet.send(senderId, response, PROTOCOL)
    end
end