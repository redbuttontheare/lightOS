math.randomseed(os.time())

local function getLatestSha()
    local h = http.get("https://api.github.com/repos/redbuttontheare/lightOS/commits/main")
    if not h then return nil end
    local body = h.readAll()
    h.close()
    return string.match(body, '"sha"%s*:%s*"(%x+)"')
end

local function get(path, save)
    local h = http.get(path)
    if h then
        local content = h.readAll()
        h.close()
        local f = fs.open(save, "w")
        f.write(content)
        f.close()
        print(save .. ": " .. #content .. " bytes")
    else
        print("FAIL: " .. path)
    end
end

local sha = getLatestSha()
if not sha then
    print("can be")
    sha = "main"
end

local base = "https://cdn.jsdelivr.net/gh/redbuttontheare/lightOS@" .. sha .. "/"

get(base .. "Install.lua", "Install.lua")
shell.run("Install.lua")