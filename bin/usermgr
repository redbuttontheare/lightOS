local lapi = dofile("/lib/lapi.lua")
local args = { ... }
local subcommand = args[1]

local function userExists(username)
    return fs.exists("/home/" .. username) and fs.isDir("/home/" .. username)
end

local function login()
    term.clear()
    term.setCursorPos(20, 1)
    print("Enter username to log in")
    term.setCursorPos(20, 2)
    term.setTextColor(colors.yellow)
    write("usermgr> ")
    term.setTextColor(colors.white)

    local usnl = read()

    if not usnl or usnl == "" then
        printError("No username entered.")
        return
    end

    if not userExists(usnl) then
        printError("No such user: " .. usnl)
        return
    end

    term.clear()
    term.setCursorPos(1,1)
    _G.currentUser = usnl
    shell.setDir("/home/" .. usnl)
    shell.run("/lightOS/kernel.lua")
end

local function create_user(username)
    if not username or username == "" then
        printError("Usage: usermgr add <username>")
        return false
    end

    if userExists(username) then
        printError("User already exists: " .. username)
        return false
    end

    fs.makeDir("/home/" .. username)

    local ucfg1 = fs.open("/home/" .. username .. "/.user", "w")
    if not ucfg1 then
        printError("Could not create user config for: " .. username)
        return false
    end
    ucfg1.writeLine("usr=" .. username)
    ucfg1.close()

    local wlightshl = fs.open("/home/" .. username .. "/.lightshl", "w")
    if not wlightshl then
        printError("Could not create .lightshl for: " .. username)
        return false
    end
    wlightshl.writeLine("-- /home/" .. username .. "/.lightshl")
    wlightshl.writeLine("local l = dofile(\"/lib/lapi.lua\")")
    wlightshl.writeLine("local cfg = l.loadConfig(\"/lightOS/config.cfg\")")
    wlightshl.writeLine("local lightos_ver = cfg.ver")
    wlightshl.writeLine("")
    wlightshl.writeLine("shell.setDir(\"/home/\" .. _G.currentUser)")
    wlightshl.writeLine("print(\"lightOS v\" .. lightos_ver)")
    wlightshl.writeLine("print(\"gelaxy v\" .. tostring(_G.gelaxy_ver))")
    wlightshl.close()

    return true
end


local function delete_user(username)
    if not username or username == "" then
        printError("Usage: usermgr del <username>")
        return
    end

    if not userExists(username) then
        printError("No such user: " .. username)
        return
    end

    if username == _G.currentUser then
        printError("Cannot delete the currently logged in user.")
        return
    end

    write("Delete user '" .. username .. "' and all their files? (y/n): ")
    local answer = read()
    if answer ~= "y" and answer ~= "Y" then
        print("Cancelled.")
        return
    end

    fs.delete("/home/" .. username)
    print("Deleted user: " .. username)
end


local function list_users()
    if not fs.exists("/home") then
        print("No users found (no /home directory).")
        return
    end

    local entries = fs.list("/home")
    local found = false

    for _, name in ipairs(entries) do
        if fs.isDir("/home/" .. name) then
            found = true
            local marker = (name == _G.currentUser) and " (current)" or ""
            print("  " .. name .. marker)
        end
    end

    if not found then
        print("No users found.")
    end
end

local function currusr()
    if _G.currentUser then
        print(_G.currentUser)
    else
        print("No user logged in.")
    end
end

-- === Main ===

if subcommand == "login" then
    login()

elseif subcommand == "--version" then
    local pcfg = lapi.loadConfig("/lightOS/config.cfg")
    local ver = pcfg.usermgr_ver or "unknown"
    print("GNU lightOS usermgr v" .. ver)
    print("by redbuttontheare@github.com")

elseif subcommand == "curusr" then
    currusr()

elseif subcommand == "add" then
    local usnametosend = args[2]
    if create_user(usnametosend) then
        print("Created user with name: " .. usnametosend)
    end

elseif subcommand == "del" then
    delete_user(args[2])

elseif subcommand == "list" then
    list_users()

else
    print("Usage:")
    print("  usermgr login          -- the login window")
    print("  usermgr --version      -- print usermgr version")
    print("  usermgr curusr         -- displays current user name")
    print("  usermgr add <username> -- create a user")
    print("  usermgr del <username> -- delete a user")
    print("  usermgr list           -- list all users")
end